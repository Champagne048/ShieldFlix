<?xml version="1.0" encoding="utf-8"?>
<!-- Cho phép HTTP thường: máy chủ stream 127.0.0.1 và Jackett/Prowlarr trong mạng LAN -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
